// Compatible Prisma 4.x — utiliser l'ancienne syntaxe pour generator / datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  employeeId    String    @unique @map("employee_id")
  fullName      String    @map("full_name")
  email         String?   @unique
  phone         String?
  passwordHash  String    @map("password_hash")
  role          Role      @default(AGENT)
  faceEncoding  String?   @map("face_encoding")
  photoUrl      String?   @map("photo_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  checkIns      CheckIn[]
  incidents     Incident[]
  sentAlerts    Alert[]   @relation("sent_alerts")
  validatedCheckIns CheckIn[] @relation("validated_checkins")
  userAlerts    UserAlert[]   // 👈 LIGNE MANQUANTE

  @@map("users")
}


model QrCode {
  id            Int       @id @default(autoincrement())
  date          DateTime  @unique
  token         String    @unique
  qrCodeData    String?   @map("qr_code_data")
  isActive      Boolean   @default(true) @map("is_active")
  validFrom     String    @default("00:00") @map("valid_from")
  validTo       String    @default("05:30") @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  checkIns      CheckIn[]
  
  @@map("qr_codes")
}

model CheckIn {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  qrCodeId            Int       @map("qr_code_id")
  checkInTime         DateTime  @default(now()) @map("check_in_time")
  location            String?
  faceMatchConfidence Float?    @map("face_match_confidence")
  status              CheckInStatus @default(PENDING)
  photoUrl            String?   @map("photo_url")
  validatedById       Int?      @map("validated_by_id")
  validatedAt         DateTime? @map("validated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  
  user                User      @relation(fields: [userId], references: [id])
  qrCode              QrCode    @relation(fields: [qrCodeId], references: [id])
  validatedBy         User?     @relation(fields: [validatedById], references: [id], name: "validated_checkins")
  
  @@map("check_ins")
}

model Incident {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String
  description String?
  type        String?
  severity    Severity  @default(MEDIUM)
  location    String?
  status      IncidentStatus @default(REPORTED)
  photoUrls   String[]  @map("photo_urls")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  
  user        User      @relation(fields: [userId], references: [id])
  
  @@map("incidents")
}

model Alert {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String?
  sentById  Int      @map("sent_by_id")
  sentToAll Boolean  @default(true) @map("sent_to_all")
  createdAt DateTime @default(now()) @map("created_at")
  
  sentBy    User     @relation(fields: [sentById], references: [id], name: "sent_alerts")
  userAlerts UserAlert[]
  
  @@map("alerts")
}

model UserAlert {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  alertId   Int      @map("alert_id")
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  
  user      User     @relation(fields: [userId], references: [id])
  alert     Alert    @relation(fields: [alertId], references: [id])
  
  @@unique([userId, alertId])
  @@map("user_alerts")
}

enum Role {
  ADMIN
  SUB_ADMIN
  AGENT
}

enum CheckInStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  IN_PROGRESS
  RESOLVED
}