# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/securis_db"

# JWT
JWT_SECRET="votre_super_secret_jwt_pour_development_seulement"
JWT_EXPIRES_IN=24h

# Application
FRONTEND_URL="http://localhost:5173"
MAX_FILE_SIZE=5242880 # 5MB
UPLOAD_PATH="./uploads"

# Admin initial (à changer après)
DEFAULT_ADMIN_EMAIL="admin@securis.com"
DEFAULT_ADMIN_PASSWORD="admin"